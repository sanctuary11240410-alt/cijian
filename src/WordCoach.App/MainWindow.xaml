<Window x:Class="WordCoach.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="词间" Width="1200" Height="820" MinWidth="1000" MinHeight="680"
 WindowStartupLocation="CenterScreen" Background="#F7F8FA" FontFamily="Microsoft YaHei UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#253039"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#287C81"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="#DEE4E8" BorderThickness="1">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.84"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#287C81"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#63707A"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DCE2E6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="MinWidth" Value="150"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Expander"><Setter Property="Padding" Value="0,5"/><Setter Property="Foreground" Value="#61717A"/></Style>
 </Window.Resources>
 <Grid Background="#F7F8FA">
  <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#E3E7EB" BorderThickness="0,0,1,0">
   <Grid Margin="16,26,16,16">
    <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="12,0"><TextBlock Text="词间" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="每天，记住一点。" FontSize="11" Foreground="#849099" Margin="0,7,0,0"/></StackPanel>
    <StackPanel Grid.Row="1">
     <Button x:Name="NavHome" Style="{StaticResource NavButton}" Content="学  习" Click="Home_Click"/>
     <Button x:Name="NavPool" Style="{StaticResource NavButton}" Content="词  库" Click="Pool_Click"/>
     <Button x:Name="NavWeek" Style="{StaticResource NavButton}" Content="计  划" Click="Week_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Button x:Name="NavStory" Style="{StaticResource NavButton}" Content="趣味短文" Click="Story_Click"/>
     <Button x:Name="NavProfiles" Style="{StaticResource NavButton}" Content="学习档案" Click="Profiles_Click"/>
     <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="设置与备份" Click="Settings_Click"/>
     <TextBlock Text="●  本机保存" Foreground="#287C81" FontSize="11" Margin="12,18,0,0"/>
     <TextBlock Text="0.5 · 无需联网学习" Foreground="#849099" FontSize="10" Margin="12,6,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,24,32,20">
   <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="今天" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PageEyebrow" Text="" Foreground="#7D8992" FontSize="11" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="DateLabel" FontSize="12"/><TextBlock x:Name="PoolLabel" FontSize="11" Foreground="#7D8992" Margin="0,7"/></StackPanel>
   </Grid>
   <Border x:Name="NoticeBox" Grid.Row="1" Background="#EDF4F4" CornerRadius="5" Padding="10" Margin="0,0,0,8" Visibility="Collapsed"><TextBlock x:Name="NoticeText" Foreground="#35676B" FontSize="12"/></Border>
   <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="True">
    <Button x:Name="UndoAction" Content="↶ 撤销 · Ctrl+Z" Click="Undo_Click" Background="#FFFFFF" Foreground="#61717A" Padding="10,5" FontSize="11" IsEnabled="False"/>
    <TextBlock x:Name="UndoCaption" FontSize="11" Foreground="#7D8992" VerticalAlignment="Center" Margin="12,0"/>
   </DockPanel>
   <ScrollViewer x:Name="PageScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel x:Name="PageBody"/></ScrollViewer>
   <Border x:Name="ActionDock" Grid.Row="4" BorderBrush="#DEE4E8" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0" Visibility="Collapsed"><WrapPanel x:Name="PageActions"/></Border>
  </Grid>
 </Grid>
</Window>
